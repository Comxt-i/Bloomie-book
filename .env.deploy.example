# Copy to .env.deploy on the VM; never commit the real file.
# Point this DNS name at the VM before starting, so Caddy can issue HTTPS.
APP_DOMAIN=books.example.com
POSTGRES_DB=punaan
POSTGRES_USER=punaan
# Use a URL-safe value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Use a different random value: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_HEX
